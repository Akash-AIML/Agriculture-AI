# Copy to .env and fill in your values

# Model paths (relative to backend/)
DISEASE_MODEL_PATH=models/disease_model_fp16.pth
SOIL_MODEL_PATH=models/soil_model.pth
CROP_MODEL_PATH=models/crop_model.pkl
LABEL_ENCODER_PATH=models/label_enoder_crop.pkl

# Number of disease/soil classes your CNN outputs
DISEASE_NUM_CLASSES=38
SOIL_NUM_CLASSES=4

# LLM — uses OpenAI-compatible API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
LLM_MODEL=gpt-4.1-nano

# Auth — generate a strong random string: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Redis (optional — falls back to in-memory if not set)
REDIS_URL=

# CORS — React dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173

# RAG knowledge base directory
RAG_DOCS_DIR=./rag_docs

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
