# Copy to .env and fill in your values

# Model paths (absolute or relative to backend/)
DISEASE_MODEL_PATH="/home/akash/Agri-Project/dataset/agri_ai_dataset/models/disease_model_fp16.pth"
SOIL_MODEL_PATH="/home/akash/Agri-Project/dataset/agri_ai_dataset/models/soil_model.pth"
CROP_MODEL_PATH="/home/akash/Agri-Project/dataset/agri_ai_dataset/models/crop_model.pkl"
LABEL_ENCODER_PATH="/home/akash/Agri-Project/dataset/agri_ai_dataset/models/label_enoder_crop.pkl"

# Number of disease/soil classes your CNN outputs
DISEASE_NUM_CLASSES=38
SOIL_NUM_CLASSES=4

# LLM — uses OpenAI-compatible API
OPENAI_API_KEY="sk-1mNkjU09WUAejXBxWhaA_w"
OPENAI_BASE_URL="https://apidev.navigatelabsai.com/"
LLM_MODEL="gpt-4.1-nano"

# Auth — generate a strong random string: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Redis (optional — falls back to in-memory if not set)
REDIS_URL=redis://localhost:6379

# CORS — React dev server
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# RAG knowledge base directory
RAG_DOCS_DIR=./rag_docs

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
